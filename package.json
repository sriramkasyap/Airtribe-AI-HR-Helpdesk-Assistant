    "test": "jest",
    "lint": "npm workspaces run lint",
    "seed": "cd packages/backend && npm run seed"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0"
  }
}
